# HAL9MIL Sync Agent — Configuración por servidor
# Copiar este archivo a .env y ajustar TODOS los valores marcados con <--

# ── Identidad de este servidor ────────────────────────────────────────────────

# Patente de ESTE servidor: 1627, 1656 o 1927  <-- REQUERIDO
PATENTE=1627

# Nombre para identificar este servidor en los logs de Django
AGENT_ID=servidor-1627-loginco

# ── Ruta a CASA.GDB en este servidor ─────────────────────────────────────────
# Ruta completa al archivo CASA.GDB (la carpeta puede variar por servidor)
# Ejemplos:
#   DB_PATH=C:\SAAI\CASA.GDB
#   DB_PATH=D:\Bases\LOGINCO\CASA.GDB
#   DB_PATH=C:\Program Files\Firebird\datos\CASA.GDB
DB_PATH=C:\ruta\a\CASA.GDB    # <-- REQUERIDO: ajustar al path real

# ── Conexión Firebird ─────────────────────────────────────────────────────────
# En la mayoría de los casos no hay que cambiar estos valores
FB_HOST=localhost
FB_PORT=3050
FB_USER=SYSDBA
FB_PASSWORD=masterkey

# Ruta al fbclient.dll de 64-bit (solo necesario si Python es 64-bit y Firebird 32-bit)
# Si aparece el error "[WinError 193] no es una aplicación Win32 válida", descomenta
# esta línea y ajusta la ruta a donde esté instalado Firebird en este servidor:
# FB_CLIENT_PATH=C:\Program Files\Firebird\Firebird_2_5\bin\fbclient.dll

# ── Destino Django (servidor en la nube) ──────────────────────────────────────
# URL del endpoint en DigitalOcean (producción)
DJANGO_SYNC_URL=https://hal9mil.loginco.com.mx/api/sync/   # <-- ajustar al dominio real
# Para pruebas locales (servidor Django corriendo en esta misma máquina):
# DJANGO_SYNC_URL=http://127.0.0.1:8001/api/sync/

# Token secreto — debe ser EXACTAMENTE el mismo que SYNC_SECRET_KEY en el .env de Django
SYNC_SECRET_KEY=CAMBIAR-ESTA-CLAVE   # <-- REQUERIDO: generar una clave aleatoria larga

# ── Parámetros de red (opcionales) ───────────────────────────────────────────
REQUEST_TIMEOUT=120
MAX_RETRIES=2
